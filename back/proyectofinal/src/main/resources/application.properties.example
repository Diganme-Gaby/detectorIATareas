spring.application.name=proyectofinal

spring.jpa.hibernate.ddl-auto=update
spring.datasource.url=jdbc:mysql://HOST:3306/BASE_DE_DATOS
spring.datasource.username=CAMBIAR_USUARIO_BD
spring.datasource.password=CAMBIAR_CLAVE_BD
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
spring.jpa.open-in-view=false


server.port=8080
#para ver el sql en la consola para testeo
#spring.jpa.show-sql: true

# Configuracion JWT (minimo 32 caracteres)
jwt.secret=CAMBIAR_SECRETO_LARGO_DE_AL_MENOS_32_CARACTERES


# Correo (Gmail con contrasena de aplicacion)
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=CAMBIAR_CORREO@gmail.com
spring.mail.password=CAMBIAR_CLAVE_DE_APLICACION_GMAIL
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
spring.mail.properties.mail.smtp.connectiontimeout=10000
spring.mail.properties.mail.smtp.timeout=20000
spring.mail.properties.mail.smtp.writetimeout=20000
app.mail.from-name=Detector IA - Universidad El Bosque

# URL del front: los enlaces de los correos llevan aqui
app.frontend-url=http://localhost:4200

# Usuarios que se precargan al iniciar
app.admin.username=CAMBIAR_USUARIO_ADMIN
app.admin.email=CAMBIAR_CORREO_ADMIN
app.admin.password=CAMBIAR_CLAVE_ADMIN


# Limites de los analisis
spring.servlet.multipart.max-file-size=20MB
spring.servlet.multipart.max-request-size=60MB
app.analysis.max-files=10
app.analysis.max-zip-entries=30
app.analysis.max-text-chars=12000
app.analysis.github-max-files=15
app.analysis.github-max-file-kb=400
app.analysis.github-default-extensions=java,ts,html,css,scss,js,py,sql,xml,properties,yml,md



# Inteligencias artificiales por API REST
ai.timeout-seconds=150
# Reutiliza el resultado si el mismo archivo (mismo hash) ya se analizo con el mismo modelo
ai.cache.enabled=true

# 1) Google Gemini (AI Studio)
ai.gemini.api-key=CAMBIAR
ai.gemini.url=https://generativelanguage.googleapis.com/v1beta/models
ai.gemini.model=gemini-flash-latest
ai.gemini.min-interval-ms=13000

# 2) Groq (formato compatible con OpenAI)
ai.groq.api-key=CAMBIAR
ai.groq.url=https://api.groq.com/openai/v1
ai.groq.model-text=openai/gpt-oss-120b
ai.groq.model-vision=qwen/qwen3.8-27b
ai.groq.model-audio=whisper-large-v3-turbo
ai.groq.min-interval-ms=2500
ai.groq.image-url-as-object=true

# 3) OpenRouter (formato compatible con OpenAI). openrouter/free escoge un modelo gratuito disponible
ai.openrouter.api-key=CAMBIAR
ai.openrouter.url=https://openrouter.ai/api/v1
ai.openrouter.model-text=openrouter/free
ai.openrouter.model-vision=openrouter/free
ai.openrouter.min-interval-ms=3500
ai.openrouter.image-url-as-object=true
ai.openrouter.json-mode=false

# ===== IAs de respaldo =====

# NVIDIA: respaldo de Gemini
ai.nvidia.api-key=CAMBIAR
ai.nvidia.url=https://integrate.api.nvidia.com/v1
ai.nvidia.model-text=meta/llama-3.3-70b-instruct
ai.nvidia.model-vision=meta/llama-3.2-90b-vision-instruct
ai.nvidia.min-interval-ms=2000

# Cohere: respaldo de Groq
ai.cohere.api-key=CAMBIAR
ai.cohere.url=https://api.cohere.ai/compatibility/v1
ai.cohere.model-text=command-a-03-2025
ai.cohere.model-vision=
ai.cohere.min-interval-ms=3500

# GitHub Models: respaldo de OpenRouter
ai.github-models.api-key=CAMBIAR
ai.github-models.url=https://models.github.ai/inference
ai.github-models.model-text=openai/gpt-4.1-mini
ai.github-models.model-vision=openai/gpt-4.1-mini
ai.github-models.min-interval-ms=4500


app.aes.key=CAMBIAR_16_CHARS

# Geolocalizacion para la auditoria
app.geo.enabled=true
app.geo.public-ip-url=https://api.ipify.org?format=json
app.geo.locate-url=http://ip-api.com/json/

# Configuracion de Swagger
springdoc.swagger-ui.path=/
# Prevenir escape de HTML en la documentacion de Swagger
springdoc.swagger-ui.docExpansion=none
springdoc.swagger-ui.syntaxHighlight.activated=true
springdoc.swagger-ui.syntaxHighlight.theme=markdown
springdoc.swagger-ui.displayRequestDuration=true
springdoc.swagger-ui.filter=true
springdoc.swagger-ui.tryItOutEnabled=true
springdoc.swagger-ui.supportedSubmitMethods=get,post,put,delete
# Estas son las propiedades clave para prevenir el escape de HTML
springdoc.swagger-ui.disable-swagger-default-url=true
springdoc.swagger-ui.html-escaping.enabled=false
